/build_*/
/node_modules/
/source/assets/build/
# Written by the dev server; committing it would point the deployed
# site's asset URLs at localhost:5173.
/source/hot
/vendor/
.DS_Store
/cache/
/.claude/
/.venv
# Bytecode from the build_*.py scripts.
__pycache__/

# Cloudflare Worker (worker/)
# .dev.vars holds the same secrets as `wrangler secret put` for local runs.
# It must never be committed.
worker/.dev.vars
worker/node_modules/
worker/.wrangler/
